# Sellora Frontend Environment Variables
# Copy to .env and fill in your values.

# Backend API base URL (no trailing slash)
# Local dev:   http://localhost:8000
# Production:  https://api.sellora.co.ke
VITE_API_BASE_URL=http://localhost:8000

# SaaS root domain for subdomain-based storefront routing.
# When set, any subdomain of this domain is treated as a storefront slug.
# Example: "sellora.co.ke" means kladi-collections.sellora.co.ke → storefront
#
# Leave EMPTY for local development.
# In local dev, use *.localhost subdomains:
#   kladi-collections.localhost:5173 → storefront for "kladi-collections"
#   localhost:5173                    → admin SaaS
VITE_SAAS_DOMAIN=
